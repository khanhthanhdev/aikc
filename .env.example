NEXT_PUBLIC_SITE_URL="·····"
NEXT_PUBLIC_SITE_EMAIL="·····"

CRON_SECRET="·····"

# Admin panel bootstrap: comma-separated emails or domains (e.g.
# "you@vinuni.edu.vn,@vinuni.edu.vn") allowed to sign in before anyone is
# added from /admin/users. Leaving it empty allows NOBODY, so set at least
# your own email on a fresh install. A blocked account in /admin/users stays
# blocked even if it is listed here.
ALLOWED_EMAILS="·····"

DATABASE_URL="postgresql://aikc:aikc@localhost:5432/aikc?schema=public"
DATABASE_URL_UNPOOLED="postgresql://aikc:aikc@localhost:5432/aikc?schema=public"
POSTGRES_USER="aikc"
POSTGRES_PASSWORD="aikc"
POSTGRES_DB="aikc"

# Operator-only: source database used by pgcopydb bootstrap and verification
SYNC_SOURCE_DATABASE_URL="postgresql://user:password@source-host:5432/aikc?sslmode=require"

# Auth
AUTH_URL="http://localhost:5175"
NEXTAUTH_URL="http://localhost:5175"
AUTH_SECRET="·····"
AUTH_GOOGLE_ID="·····"
AUTH_GOOGLE_SECRET="·····"

# Local vector stack
USE_LOCAL_EMBEDDING="true"
INFINITY_EMBEDDING_URL="http://localhost:7997/v1"
INFINITY_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
INFINITY_EMBEDDING_DIMENSIONS="384"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="local-qdrant-api-key"

# OpenAI
OPENAI_API_KEY="·····"

# Anthropic
ANTHROPIC_API_KEY="·····"

# Gemini
GEMINI_API_KEY="·····"
# Main chat, RAG, and translation model. Set this to a Gemini model ID
# available to the API key, for example "gemini-2.5-flash".
GOOGLE_FLASH_MODEL="gemini-2.5-flash-lite"
# Fast model used for lightweight query routing and content generation.
GOOGLE_FLASH_LITE_MODEL="gemini-2.5-flash-lite"
# Model for batch jobs that write a structured reply per tool (roles,
# categories). Keep it a Gemini model: Gemma fails about a third of them.
GOOGLE_BATCH_MODEL="gemini-flash-lite-latest"

# Chat quotas (in-memory: restarting the app container resets the counters)
CHAT_RATE_LIMIT_PER_MINUTE="10"
# Per IP per day; a whole campus can share one IP
CHAT_RATE_LIMIT_PER_DAY="300"
# Per browser session (cookie) per day
CHAT_RATE_LIMIT_PER_SESSION_PER_DAY="50"

# Firecrawl
FIRECRAWL_API_KEY="·····"

# Resend
RESEND_API_KEY="·····"

# Beehiiv
BEEHIIV_API_KEY="·····"
BEEHIIV_PUBLICATION_ID="·····"

# Umami analytics (self-hosted, `umami` service in docker-compose.yml)
# Database password for the `umami` role; use letters and digits only, it is
# put into a connection URL (e.g. `openssl rand -hex 24`).
UMAMI_DB_PASSWORD="·····"
# Signs dashboard logins (e.g. `openssl rand -hex 32`).
UMAMI_APP_SECRET="·····"
# Website ID from the Umami dashboard (Settings > Websites). The tracker stays
# off the site while this is empty. Read at build time: rebuild after setting.
UMAMI_WEBSITE_ID=""
# Where the app reaches Umami to proxy the tracker; the compose default works.
# UMAMI_URL="http://umami:3000"


# Stripe
STRIPE_SECRET_KEY="·····"
STRIPE_SIGNING_SECRET="·····"
STRIPE_PRODUCT_IDS="prod_·····"

# Cloudflare R2
R2_BUCKET=""
R2_ENDPOINT=""
# Public r2.dev or custom-domain URL for the aikc bucket.
R2_PUBLIC_URL="https://<your-public-r2-domain>"
R2_ACCESS_KEY_ID="·····"
R2_SECRET_ACCESS_KEY="·····"
