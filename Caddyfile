{
	auto_https off
	admin off
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	log {
		output stdout
		format console
	}

	# Security headers (defense-in-depth, also applied by Next.js)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		-Server
		-X-Powered-By
	}

	# Preserve separate CDN cache entries for HTML and Markdown homepages.
	@markdown_home path / /en /en/ /vi /vi/
	header @markdown_home +Vary "Accept"

	# Every route lives in a `handle` block: Caddy runs `handle` before a bare
	# `respond`, so a top-level `respond` would never fire once the catch-all
	# below exists (it did not, which let direct IP requests reach the app).

	# Block direct IP access - only allow requests via Cloudflare with proper Host.
	# `abort` closes the connection without a response.
	@blocked {
		not header_regexp Host ^((www|stats)\.)?aikc\.vn$
	}
	handle @blocked {
		abort
	}

	handle /healthz {
		respond 200
	}

	# Cloudflare proxy health check
	handle /cdn-cgi/trace {
		respond 200
	}

	# Umami analytics dashboard. Needs a proxied DNS record for the host in
	# Cloudflare. The public site loads the tracker through the app instead.
	@stats host stats.aikc.vn
	handle @stats {
		reverse_proxy umami:3000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}

	# Main app
	handle {
		reverse_proxy app:5175 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
			header_up X-Forwarded-Host {http.request.header.Host}
		}
	}
}
