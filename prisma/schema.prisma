generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

enum ReportType {
  BROKEN_LINK
  WRONG_CATEGORY
  OUTDATED
  OTHER
}

enum AdType {
  Banner
  Similars
  Tools
  ToolPage
  BlogPost
  All
}

enum TranslationStatus {
  MISSING
  MACHINE
  REVIEWED
}

enum UserRole {
  ADMIN
  USER
}

enum PricingTier {
  FREE
  FREEMIUM
  PAID
  OPEN_SOURCE
  CUSTOM
}

model Ad {
  id          String   @id @default(cuid())
  email       String
  name        String
  description String?
  websiteUrl  String
  buttonLabel String?
  faviconUrl  String?
  type        AdType   @default(All)
  startsAt    DateTime
  endsAt      DateTime
  stepOrder   Int      @default(0)
  listInjectionIndex Int @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tool {
  id             String    @id @default(cuid())
  name           String    @db.Citext
  nameVi         String?   @db.Citext
  slug           String    @unique
  tagline        String?
  taglineVi      String?
  description    String?
  descriptionVi  String?
  summary        String?   // 150-200 char snippet for AI citations
  summaryVi      String?   // 150-200 char snippet for AI citations (Vietnamese)
  content        String?
  contentVi      String?
  websiteUrl     String    @unique
  affiliateUrl   String?
  faviconUrl     String?
  screenshotUrl  String?
  pricing        String?
  pricingVi      String?
  pricingTier    PricingTier?
  socials        Json?
  isFeatured     Boolean   @default(false)
  isBroken       Boolean   @default(false)
  translationStatusVi TranslationStatus @default(MISSING)
  translationUpdatedAtVi DateTime?
  lastCheckedAt  DateTime?
  xHandle        String?
  submitterName  String?
  submitterEmail String?
  publishedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())
  relatedTools   String[]  @default([])
  /// Audience roles the tool suits, best fit first (keys of config/roles.ts)
  roles          String[]  @default([])
  /// Sample chat questions per role: { [role]: { en: string[], vi: string[] } }
  roleQuestions  Json?

  // Relations
  categories  Category[]
  tags        Tag[]
  reports     Report[]

  // Indexes
  @@index([id, slug])
  @@index([name])
  @@index([nameVi])
  @@index([description])
  @@index([descriptionVi])
}

model Report {
  id        String     @id @default(cuid())
  type      ReportType
  message   String?
  userEmail String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolId String

  // Indexes
  @@index([toolId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @db.Citext
  nameVi      String?  @db.Citext
  label       String?  @db.Citext
  labelVi     String?  @db.Citext
  slug        String   @unique
  description String?
  descriptionVi String?
  translationStatusVi TranslationStatus @default(MISSING)
  translationUpdatedAtVi DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // Relations
  tools Tool[]

  // Indexes
  @@index([name])
  @@index([nameVi])
}


model Tag {
  id        String   @id @default(cuid())
  name      String   @db.Citext
  nameVi    String?  @db.Citext
  slug      String   @unique
  translationStatusVi TranslationStatus @default(MISSING)
  translationUpdatedAtVi DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relations
  tools Tool[]

  // Indexes
  @@index([name])
  @@index([nameVi])
}

/// One row per accepted AI request. Written from a deferred `after()` hook so
/// logging never adds latency to the streamed answer, and never fails the
/// request when the database is unreachable.
model AiQuery {
  id        String   @id @default(cuid())
  /// Which endpoint served the request: "chat" or "rag".
  endpoint  String
  question  String
  locale    String?
  /// Slug of the tool page the question was asked from, when there was one.
  toolSlug  String?
  /// True when the semantic cache answered without calling the model.
  cacheHit  Boolean  @default(false)
  /// Salted hash of the client IP. Never the raw address, so the table can be
  /// used to count distinct askers without storing anything identifying.
  visitorId String?
  /// Time from receiving the question until the answer finished (or failed).
  latencyMs Int?
  /// How the turn ended. Rows written before answers were logged are OK.
  status       AiQueryStatus @default(OK)
  /// The answer as the model produced it (or the cache returned it), including
  /// any ---SUGGESTIONS--- block. Partial when the turn was ABORTED.
  answer       String?
  /// Provider error message when status is ERROR.
  error        String?
  /// Model that actually answered. Null for cache hits.
  model        String?
  inputTokens  Int?
  outputTokens Int?
  createdAt DateTime @default(now())

  // Indexes
  @@index([createdAt])
  @@index([endpoint, createdAt])
  @@index([visitorId])
  @@index([status, createdAt])
}

enum AiQueryStatus {
  /// The answer finished normally.
  OK
  /// The model call failed, e.g. quota exhausted or provider outage.
  ERROR
  /// The visitor closed the chat or navigated away mid-answer.
  ABORTED
}

/// A person who can sign in. Today only ADMIN rows grant anything: they are
/// the admin panel allowlist, managed from /admin/users. USER is reserved for
/// a future public sign-in and grants no admin access.
model User {
  id          String    @id @default(cuid())
  email       String    @unique @db.Citext
  name        String?
  image       String?
  role        UserRole  @default(ADMIN)
  /// Set when an admin blocks this account. A blocked row wins over
  /// ALLOWED_EMAILS, so an env-listed email can still be locked out.
  disabledAt  DateTime?
  lastLoginAt DateTime?
  /// Email of the admin who added this account; null for self-registration
  /// through ALLOWED_EMAILS.
  invitedBy   String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  // Indexes
  @@index([role])
}
